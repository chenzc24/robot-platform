APP_ACCESS_USERNAME=reviewer
APP_ACCESS_PASSWORD=replace-with-a-long-random-password
MAX_UPLOAD_MB=25
LINEART_LOCAL_SERVICE_URL=http://127.0.0.1:8010
LINEART_LOCAL_TIMEOUT_SECONDS=300
LINEART_MODEL_REPOSITORY=lllyasviel/Annotators
# Qwen cloud API mode (backend only; never expose DASHSCOPE_API_KEY to frontend code)
QWEN_CLOUD_ENABLED=true
DASHSCOPE_API_KEY=
QWEN_DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-edit-plus-2025-12-15
QWEN_IMAGE_SEED=20260902
QWEN_CLOUD_TIMEOUT_SECONDS=600
QWEN_MAX_CONCURRENCY=1
QWEN_DAILY_REQUEST_LIMIT=20
QWEN_CACHE_ENABLED=true
QWEN_CACHE_DIR=
QWEN_MAX_OUTPUT_MB=20
# Optional semantic stroke review. It shares DASHSCOPE_API_KEY but uses the
# public OpenAI-compatible endpoint instead of the image-edit workspace URL.
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.8-max-0902
QWEN_VISION_TIMEOUT_SECONDS=180
QWEN_VISION_DAILY_REQUEST_LIMIT=100
QWEN_VISION_MAX_CONCURRENCY=1
QWEN_VISION_CACHE_ENABLED=true
QWEN_VISION_CACHE_DIR=
# Optional comma-separated plugin factories (package.module:factory)
STROKE_PIPELINE_PLUGINS=
LINEART_DETECTOR_PLUGINS=
